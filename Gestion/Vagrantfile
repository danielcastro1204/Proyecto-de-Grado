# -*- mode: ruby -*-
# vi: set ft=ruby :

# =============================================================================
# Vagrantfile - Integrante A (ASUS TUF Gaming A15)
# Proyecto de Grado - Laboratorio de Ciberseguridad VLAN 30 (Gestión)
#
# Levanta dos VMs:
#   - wazuh  : Servidor SIEM Wazuh all-in-one (Ubuntu Server 22.04) → 192.168.30.10
#   - kali   : Estación atacante Kali Linux rolling              → 192.168.30.20
#
# REQUISITO: Ajusta BRIDGE_INTERFACE con el nombre exacto de tu NIC física
#            (la que conecta el portátil al Switch 2).  Ejecuta `ip link` o
#            `ipconfig` para encontrarlo.  Ejemplos comunes:
#              Linux  → "enp3s0", "wlp2s0", "eth0"
#              Windows → "Intel(R) Wi-Fi 6 AX200 160MHz", "Realtek PCIe GbE..."
# =============================================================================

BRIDGE_INTERFACE = "Realtek PCIe GbE Family Controller"

Vagrant.configure("2") do |config|

  # ---------------------------------------------------------------------------
  # VM 1: Servidor SIEM Wazuh
  # ---------------------------------------------------------------------------
  config.vm.define "wazuh1" do |wazuh1|
    wazuh1.vm.box      = "ubuntu/jammy64"
    wazuh1.vm.hostname = "wazuh-server"

    # Red en modo puente — la IP fija se asigna desde el script de aprovisionamiento
    # auto_config: false → Vagrant no intenta DHCP; el script configura la IP estática
    wazuh1.vm.network "public_network",
      bridge:      BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    wazuh1.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-Wazuh-VLAN30"
      vb.memory = 8192   # 8 GB RAM (4GB se queda corto para indexer+manager+dashboard juntos)
      vb.cpus   = 4      # más CPU reduce el riesgo de timeout al arrancar wazuh-manager
      # Habilitar PAE/NX y nested virtualization si está disponible
      vb.customize ["modifyvm", :id, "--ioapic", "on"]
      ##vb.customize ["modifyvm", :id, "--nictype1", "82545EM"]
      # Ampliar disco de vídeo (no crítico, evita warnings)
      vb.customize ["modifyvm", :id, "--vram", "16"]
    end

    # Script de aprovisionamiento
    wazuh1.vm.provision "shell",
      path:       "scripts/wazuh-server.sh",
      privileged: true
  end

  # ---------------------------------------------------------------------------
  # VM 2: Kali Linux (estación atacante)
  # ---------------------------------------------------------------------------
  config.vm.define "kali" do |kali|
    kali.vm.box      = "kalilinux/rolling"
    kali.vm.hostname = "kali-attacker"

    # Red en modo puente
    kali.vm.network "public_network",
      bridge:      BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    kali.vm.provider "virtualbox" do |vb|
      vb.name   = "Kali-Attacker-VLAN30"
      vb.memory = 2048   # 2 GB RAM
      vb.cpus   = 1
      vb.customize ["modifyvm", :id, "--ioapic", "on"]
      vb.customize ["modifyvm", :id, "--vram", "16"]
    end

    # Script de aprovisionamiento
    kali.vm.provision "shell",
      path:       "scripts/kali-attacker.sh",
      privileged: true
  end

end