# =============================================================================
# Vagrantfile - Integrante B | Proyecto SIEM - Laboratorio de Ciberseguridad
# Portátil: Lenovo Legion 5 | VLAN 10 - Servidores (192.168.10.0/24)
# Máquinas: DC (Windows Server 2019) + Web Server (Ubuntu 22.04)
# =============================================================================
#
# REQUISITOS PREVIOS:
#   vagrant plugin install vagrant-reload
#
# USO:
#   vagrant up            -> Levanta ambas máquinas
#   vagrant up dc         -> Solo el Controlador de Dominio
#   vagrant up web        -> Solo el Servidor Web
#   vagrant provision dc  -> Re-ejecutar aprovisionamiento del DC
#
# AJUSTE OBLIGATORIO: Cambiar BRIDGE_INTERFACE por el nombre de tu adaptador
# físico (ver README.md, sección "Interfaz de red puente").
# =============================================================================

# ---------------------------------------------------------------------------
# Nombre del adaptador de red físico del portátil Lenovo Legion 5
# Ejemplos comunes:
#   Windows host : "Intel(R) Wi-Fi 6 AX200 160MHz"
#                  "Realtek PCIe GbE Family Controller"
#   Linux host   : "enp4s0", "eth0", "wlp3s0"
# Si se deja vacío (""), Vagrant preguntará interactivamente.
# ---------------------------------------------------------------------------
BRIDGE_INTERFACE = ""   # <--- AJUSTAR ANTES DE EJECUTAR

Vagrant.configure("2") do |config|

  # =========================================================================
  # MÁQUINA 1: Controlador de Dominio - Windows Server 2019
  # IP: 192.168.10.20/24 | Hostname: dc-empresa | Dominio: empresa.local
  # =========================================================================
  config.vm.define "dc" do |dc|

    dc.vm.box               = "StefanScherer/windows_server_2019"
    dc.vm.box_check_update  = false
    dc.vm.hostname          = "dc-empresa"
    dc.vm.communicator      = "winrm"
    dc.winrm.max_tries      = 30
    dc.winrm.retry_sleep    = 10

    # ---- Red en modo puente (VLAN 10) ------------------------------------
    # La IP fija (192.168.10.20) se asigna dentro del SO invitado vía script.
    if BRIDGE_INTERFACE.empty?
      dc.vm.network "public_network", type: "dhcp"
    else
      dc.vm.network "public_network", type: "dhcp", bridge: BRIDGE_INTERFACE
    end

    # ---- Recursos de hardware --------------------------------------------
    dc.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-DC-empresa"
      vb.memory = 3072    # 3 GB RAM (mínimo 2 GB; ideal 4 GB si hay recursos)
      vb.cpus   = 2
      vb.gui    = false   # Cambiar a true para ver la consola durante el setup
      vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
      vb.customize ["modifyvm", :id, "--vram", "32"]
      # Mejorar rendimiento en VirtualBox
      vb.customize ["modifyvm", :id, "--nestedpaging", "on"]
      vb.customize ["modifyvm", :id, "--largepages", "on"]
    end

    # ---- Carpeta compartida (para scripts adicionales si se necesitan) ---
    dc.vm.synced_folder ".", "/vagrant", disabled: false

    # ====================================================================
    # APROVISIONAMIENTO - FASE 1
    # Instala AD DS, configura IP fija y promueve el servidor a DC.
    # Al final del script el servidor SE REINICIA.
    # El plugin vagrant-reload espera a que la VM vuelva a estar disponible.
    # ====================================================================
    dc.vm.provision "shell",
      path:        "scripts/windows-dc.ps1",
      privileged:  true,
      powershell_elevated_interactive: false

    # Reinicio automático (requiere: vagrant plugin install vagrant-reload)
    dc.vm.provision :reload

    # ====================================================================
    # APROVISIONAMIENTO - FASE 2 (post-reinicio)
    # Configura usuarios de AD, auditoría e instala el agente Wazuh.
    # ====================================================================
    dc.vm.provision "shell",
      path:        "scripts/windows-dc-second.ps1",
      privileged:  true,
      powershell_elevated_interactive: false

  end # dc


  # =========================================================================
  # MÁQUINA 2: Servidor Web - Ubuntu Server 22.04 LTS
  # IP: 192.168.10.10/24 | Hostname: web-server | Servicio: Apache2
  # =========================================================================
  config.vm.define "web" do |web|

    web.vm.box              = "ubuntu/jammy64"
    web.vm.box_check_update = false
    web.vm.hostname         = "web-server"

    # ---- Red en modo puente (VLAN 10) ------------------------------------
    if BRIDGE_INTERFACE.empty?
      web.vm.network "public_network", type: "dhcp"
    else
      web.vm.network "public_network", type: "dhcp", bridge: BRIDGE_INTERFACE
    end

    # ---- Recursos de hardware --------------------------------------------
    web.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-WebServer"
      vb.memory = 1024    # 1 GB RAM
      vb.cpus   = 1
      vb.gui    = false
    end

    # ---- Carpeta compartida ---------------------------------------------
    web.vm.synced_folder ".", "/vagrant", disabled: false

    # ====================================================================
    # APROVISIONAMIENTO - Script bash (un solo paso, no requiere reinicio)
    # Configura IP fija, instala Apache2 y el agente Wazuh.
    # ====================================================================
    web.vm.provision "shell",
      path:       "scripts/web-server.sh",
      privileged: true

  end # web

end # Vagrant.configure
