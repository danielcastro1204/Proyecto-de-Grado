# -*- mode: ruby -*-
# vi: set ft=ruby :

# =============================================================================
# Vagrantfile - Integrante B (Lenovo Legion 5)
# Proyecto de Grado - Laboratorio de Ciberseguridad VLAN 10 (Servidores)
#
# VMs:
#   - web-server   : Ubuntu 22.04        -> 192.168.10.10
#   - windows-dc   : Windows Server 2019  -> 192.168.10.20
#
# El servidor SIEM/Wazuh se encuentra en:
#   192.168.30.10
#
# Dominio:
#   empresa.local
# =============================================================================

BRIDGE_INTERFACE = "Realtek PCIe GbE Family Controller"

SIEM_IP   = "192.168.30.10"
DC_IP     = "192.168.10.20"
DOMAIN    = "empresa.local"
GATEWAY   = "192.168.10.1"

# ---- Dual-stack: direccionamiento IPv6 (VLAN10 - fd00:10::/64, segun topologia) ----
DC_IP6    = "fd00:10::20"
GATEWAY6  = "fd00:10::1"

# =============================================================================
# CORRECCION: estas constantes se usaban mas abajo (DHCPv4, DHCPv6, DNS1,
# DNS2, SMTP, NTP) pero nunca se habian definido, lo que hacia que Vagrant
# fallara de inmediato con "undefined local variable" al leer este archivo.
# Direcciones segun la tabla de direccionamiento de la topologia (VLAN10).
# =============================================================================

DHCP4_IP  = "192.168.10.30"
DHCP4_IP6 = "fd00:10::30"

DHCP6_IP  = "192.168.10.40"
DHCP6_IP6 = "fd00:10::40"

DNS1_IP   = "192.168.10.50"
DNS1_IP6  = "fd00:10::50"

DNS2_IP   = "192.168.10.60"
DNS2_IP6  = "fd00:10::60"

SMTP_IP   = "192.168.10.70"
SMTP_IP6  = "fd00:10::70"

NTP_IP    = "192.168.10.80"
NTP_IP6   = "fd00:10::80"

# ---- VLAN 20 (Clientes) - para el pool DHCP que reparte el servidor DHCP ----
# NOTA: en el diagrama original el pool aparecia escrito como
# "192.168.10.150 - 192.168.10.200" pegado a la VLAN de clientes, pero esa
# es la subred de SERVIDORES (VLAN10), no la de CLIENTES (VLAN20). Se asume
# que fue un error de rotulado en el diagrama y se usa el rango correcto
# dentro de 192.168.20.0/24. Si en realidad querias ese rango literal,
# avisame y lo cambio.
CLIENTS_GATEWAY   = "192.168.20.1"
CLIENTS_GATEWAY6  = "fd00:20::1"
CLIENTS_NET6      = "fd00:20::/64"
CLIENTS_POOL4     = "192.168.20.150 - 192.168.20.200"
CLIENTS_POOL6     = "fd00:20::150 - fd00:20::200"

# ---- Secreto TSIG compartido entre DNS1 y DNS2 para transferencias de zona ----
# Generado una sola vez con: openssl rand -base64 32
# IMPORTANTE: debe ser IDENTICO en ambos servidores (por eso vive aqui, en
# una sola constante, y se inyecta a los dos).
TSIG_SECRET = "nqF1rl+Hie0rt86wb78gLEqsGXd7POUpHk4BlsXNPfE="

Vagrant.configure("2") do |config|

  # ===========================================================================
  # Deshabilitar carpeta sincronizada por defecto
  # ===========================================================================
  config.vm.synced_folder ".", "/vagrant", disabled: true


  # ===========================================================================
  # 1. SERVIDOR WEB - Ubuntu 22.04
  # ===========================================================================
  # NO SE MODIFICA LA CONFIGURACIÓN DEL WEB SERVER
  # ===========================================================================

  config.vm.define "web-server" do |web|

    web.vm.box      = "ubuntu/jammy64"
    web.vm.hostname = "web-server"

    web.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    web.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-WebServer-VLAN10"
      vb.cpus   = 1
      vb.memory = 1024
      vb.customize ["modifyvm", :id, "--vram", "16"]
    end

    web.vm.provision "shell",
      path: "scripts/web-server.sh",
      env: {
        "VM_IP"      => "192.168.10.10",
        "VM_GATEWAY" => GATEWAY,
        "VM_DNS"     => DC_IP,
        "SIEM_IP"    => SIEM_IP,
        "DOMAIN"     => DOMAIN,
        "VM_IP6"      => "fd00:10::10",
        "VM_GATEWAY6" => GATEWAY6,
        "VM_DNS6"     => DC_IP6
      }
  end


  # ===========================================================================
  # 2. CONTROLADOR DE DOMINIO - Windows Server 2019
  # ===========================================================================

  config.vm.define "windows-dc" do |dc|

    dc.vm.box = "jborean93/WindowsServer2019"

    # IMPORTANTE:
    # No usamos dc.vm.hostname aquí para evitar el bug de Vagrant de "Waiting for reboot".
    # Lo solucionaremos con una Fase 0 manual.
    dc.vm.communicator = "winrm"

    dc.winrm.username = "vagrant"
    dc.winrm.password = "vagrant"
    dc.winrm.transport = :ssl
    dc.winrm.ssl_peer_verification = false
    dc.winrm.port = 5986

    dc.vm.boot_timeout = 1800

    dc.winrm.timeout = 1800
    dc.winrm.retry_limit = 100
    dc.winrm.max_wait_time = 1800


    # -------------------------------------------------------------------------
    # NOTA: AllowUnencrypted en WinRM
    #
    # El box trae por defecto AllowUnencrypted = false, lo que impide que
    # Vagrant se autentique por WinRM (transporte plaintext). Esto NO se
    # puede arreglar de forma automatica desde el Vagrantfile: se necesita
    # una sesion interactiva real dentro de Windows (VBoxManage guestcontrol
    # corre en Sesion 0, sin escritorio interactivo, y ahi la elevacion UAC
    # esta bloqueada por diseno del sistema operativo).
    #
    # SOLUCION APLICADA (una sola vez, ya hecha): se arranco la VM maestra
    # (la que Vagrant usa como base para clonar) directamente desde
    # VirtualBox, se inicio sesion como vagrant, se abrio PowerShell como
    # Administrador y se corrio:
    #
    #   winrm set winrm/config/service '@{AllowUnencrypted="true"}'
    #
    # y se apago limpiamente la VM. Como los clones de windows-dc se crean
    # a partir de esa maestra, todos los clones nuevos (incluso despues de
    # "vagrant destroy") ya nacen con este ajuste aplicado.
    #
    # Si en el futuro se reimporta el box desde cero (nueva version, otra
    # maquina, etc.), hay que repetir este paso una vez sobre la nueva
    # maestra antes de usar "vagrant up".
    # -------------------------------------------------------------------------


    # -------------------------------------------------------------------------
    # Red VLAN 10
    # -------------------------------------------------------------------------

    dc.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false


    # -------------------------------------------------------------------------
    # VirtualBox
    # -------------------------------------------------------------------------

    dc.vm.provider "virtualbox" do |vb|

      vb.name   = "SIEM-WindowsDC-VLAN10"
      vb.cpus   = 2
      vb.memory = 2048
      vb.gui    = false

      vb.customize ["modifyvm", :id, "--vram", "32"]
      vb.customize ["modifyvm", :id, "--clipboard", "disabled"]
      vb.customize ["modifyvm", :id, "--draganddrop", "disabled"]
      vb.customize ["modifyvm", :id, "--ioapic", "on"]
      vb.customize ["modifyvm", :id, "--paravirtprovider", "default"]

    end


    # -------------------------------------------------------------------------
    # Plugin para controlar el reinicio
    # -------------------------------------------------------------------------

    unless Vagrant.has_plugin?("vagrant-reload")
      raise "ERROR: Instala el plugin con: vagrant plugin install vagrant-reload"
    end


    # -------------------------------------------------------------------------
    # FASE 0: CAMBIO DE HOSTNAME MANUAL (Workaround para el bug de Vagrant)
    #
    # Cambiamos el nombre por código y hacemos un vagrant-reload seguro
    # antes de ejecutar la promoción a DC.
    # -------------------------------------------------------------------------
    dc.vm.provision "rename-hostname", type: "shell", powershell_elevated_interactive: false, inline: <<-SHELL
      $ExpectedName = "dc-empresa"
      if ($env:COMPUTERNAME -ne $ExpectedName) {
        Write-Host "Cambiando hostname a $ExpectedName..."
        Rename-Computer -NewName $ExpectedName -Force
      } else {
        Write-Host "El hostname ya es $ExpectedName. No requiere cambio."
      }
    SHELL

    dc.vm.provision :reload


    # -------------------------------------------------------------------------
    # FASE 1
    #
    # Configuración de red
    # Instalación AD DS
    # Instalación DNS
    # Promoción a controlador de dominio
    # Firewall
    # Auditoría
    #
    # El script NO reinicia Windows.
    # El reinicio lo hará vagrant-reload.
    # -------------------------------------------------------------------------

    dc.vm.provision "shell",
      path: "scripts/windows-dc.ps1",
      powershell_elevated_interactive: false,
      env: {
        "VM_IP"      => DC_IP,
        "VM_GATEWAY" => GATEWAY,
        "SIEM_IP"    => SIEM_IP,
        "DOMAIN"     => DOMAIN
      }


    # -------------------------------------------------------------------------
    # REINICIO CONTROLADO (Entre Fase 1 y Fase 2)
    # -------------------------------------------------------------------------

    dc.vm.provision :reload


    # -------------------------------------------------------------------------
    # FASE 2
    #
    # Usuarios
    # DNS
    # GPO
    # Wazuh Agent
    # RDP
    # -------------------------------------------------------------------------

    dc.vm.provision "shell",
      path: "scripts/windows-dc-second.ps1",
      powershell_elevated_interactive: false,
      env: {
        "SIEM_IP" => SIEM_IP,
        "DOMAIN"  => DOMAIN
      }

  end

    # ---------------------------------------------------------------------------
  # 3. Servidor DHCPv4 (Kea) - VLAN 10 (Servidores) -> 192.168.10.30
  #    Atiende las solicitudes DHCP de la VLAN 20 (Clientes) vía DHCP relay
  #    configurado en el router (ip helper-address 192.168.10.30).
  # ---------------------------------------------------------------------------
  config.vm.define "dhcpv4-server" do |d4|
    d4.vm.box      = "ubuntu/jammy64"
    d4.vm.hostname = "dhcpv4-server"

    d4.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    d4.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-DHCPv4-VLAN10"
      vb.cpus   = 1
      vb.memory = 512
    end

    d4.vm.provision "shell",
      path: "scripts/dhcpv4-server.sh",
      env: {
        "VM_IP"           => DHCP4_IP,
        "VM_IP6"          => DHCP4_IP6,
        "VM_GATEWAY"      => GATEWAY,
        "VM_GATEWAY6"     => GATEWAY6,
        "VM_DNS"          => DNS1_IP,
        "VM_DNS2"         => DNS2_IP,
        "SIEM_IP"         => SIEM_IP,
        "DOMAIN"          => DOMAIN,
        "CLIENTS_GATEWAY" => CLIENTS_GATEWAY,
        "CLIENTS_POOL4"   => CLIENTS_POOL4
      }
  end

  # ---------------------------------------------------------------------------
  # 4. Servidor DHCPv6 (Kea) - VLAN 10 (Servidores) -> 192.168.10.40
  #    Atiende las solicitudes DHCPv6 de la VLAN 20 (Clientes) vía DHCP relay.
  # ---------------------------------------------------------------------------
  config.vm.define "dhcpv6-server" do |d6|
    d6.vm.box      = "ubuntu/jammy64"
    d6.vm.hostname = "dhcpv6-server"

    d6.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    d6.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-DHCPv6-VLAN10"
      vb.cpus   = 1
      vb.memory = 512
    end

    d6.vm.provision "shell",
      path: "scripts/dhcpv6-server.sh",
      env: {
        "VM_IP"            => DHCP6_IP,
        "VM_IP6"           => DHCP6_IP6,
        "VM_GATEWAY"       => GATEWAY,
        "VM_GATEWAY6"      => GATEWAY6,
        "VM_DNS6"          => DNS1_IP6,
        "VM_DNS6_2"        => DNS2_IP6,
        "SIEM_IP"          => SIEM_IP,
        "DOMAIN"           => DOMAIN,
        "CLIENTS_NET6"     => CLIENTS_NET6,
        "CLIENTS_GATEWAY6" => CLIENTS_GATEWAY6,
        "CLIENTS_POOL6"    => CLIENTS_POOL6
      }
  end

  # ---------------------------------------------------------------------------
  # 5. Servidor DNS1 - Primario/Maestro (BIND9) - VLAN 10 -> 192.168.10.50
  # ---------------------------------------------------------------------------
  config.vm.define "dns1-server" do |ns1|
    ns1.vm.box      = "ubuntu/jammy64"
    ns1.vm.hostname = "dns1-server"

    ns1.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    ns1.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-DNS1-VLAN10"
      vb.cpus   = 1
      vb.memory = 512
    end

    ns1.vm.provision "shell",
      path: "scripts/dns1-server.sh",
      env: {
        "VM_IP"       => DNS1_IP,
        "VM_IP6"      => DNS1_IP6,
        "VM_GATEWAY"  => GATEWAY,
        "VM_GATEWAY6" => GATEWAY6,
        "SIEM_IP"     => SIEM_IP,
        "DOMAIN"      => DOMAIN,
        "DNS2_IP"     => DNS2_IP,
        "DNS2_IP6"    => DNS2_IP6,
        "TSIG_SECRET" => TSIG_SECRET
      }
  end

  # ---------------------------------------------------------------------------
  # 6. Servidor DNS2 - Secundario/Esclavo (BIND9) - VLAN 10 -> 192.168.10.60
  # ---------------------------------------------------------------------------
  config.vm.define "dns2-server" do |ns2|
    ns2.vm.box      = "ubuntu/jammy64"
    ns2.vm.hostname = "dns2-server"

    ns2.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    ns2.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-DNS2-VLAN10"
      vb.cpus   = 1
      vb.memory = 512
    end

    ns2.vm.provision "shell",
      path: "scripts/dns2-server.sh",
      env: {
        "VM_IP"       => DNS2_IP,
        "VM_IP6"      => DNS2_IP6,
        "VM_GATEWAY"  => GATEWAY,
        "VM_GATEWAY6" => GATEWAY6,
        "SIEM_IP"     => SIEM_IP,
        "DOMAIN"      => DOMAIN,
        "DNS1_IP"     => DNS1_IP,
        "DNS1_IP6"    => DNS1_IP6,
        "TSIG_SECRET" => TSIG_SECRET
      }
  end

  # ---------------------------------------------------------------------------
  # 7. Servidor SMTP (Postfix + Dovecot) - VLAN 10 -> 192.168.10.70
  # ---------------------------------------------------------------------------
  config.vm.define "smtp-server" do |smtp|
    smtp.vm.box      = "ubuntu/jammy64"
    smtp.vm.hostname = "smtp-server"

    smtp.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    smtp.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-SMTP-VLAN10"
      vb.cpus   = 1
      vb.memory = 768
    end

    smtp.vm.provision "shell",
      path: "scripts/smtp-server.sh",
      env: {
        "VM_IP"       => SMTP_IP,
        "VM_IP6"      => SMTP_IP6,
        "VM_GATEWAY"  => GATEWAY,
        "VM_GATEWAY6" => GATEWAY6,
        "VM_DNS"      => DNS1_IP,
        "SIEM_IP"     => SIEM_IP,
        "DOMAIN"      => DOMAIN
      }
  end

  # ---------------------------------------------------------------------------
  # 8. Servidor NTP (chrony) - VLAN 10 -> 192.168.10.80
  # ---------------------------------------------------------------------------
  config.vm.define "ntp-server" do |ntp|
    ntp.vm.box      = "ubuntu/jammy64"
    ntp.vm.hostname = "ntp-server"

    ntp.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    ntp.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-NTP-VLAN10"
      vb.cpus   = 1
      vb.memory = 512
    end

    ntp.vm.provision "shell",
      path: "scripts/ntp-server.sh",
      env: {
        "VM_IP"       => NTP_IP,
        "VM_IP6"      => NTP_IP6,
        "VM_GATEWAY"  => GATEWAY,
        "VM_GATEWAY6" => GATEWAY6,
        "VM_DNS"      => DNS1_IP,
        "SIEM_IP"     => SIEM_IP,
        "DOMAIN"      => DOMAIN
      }
  end

end