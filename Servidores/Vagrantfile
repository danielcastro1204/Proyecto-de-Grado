# -*- mode: ruby -*-
# vi: set ft=ruby :

# =============================================================================
# Vagrantfile - Integrante B (Lenovo Legion 5)
# Proyecto de Grado - Laboratorio de Ciberseguridad VLAN 10 (Servidores)
#
# VMs:
#   - web-server   : Ubuntu 22.04        -> 192.168.10.10
#   - windows-dc   : Windows Server 2019  -> 192.168.10.20
#
# El servidor SIEM/Wazuh se encuentra en:
#   192.168.30.10
#
# Dominio:
#   empresa.local
# =============================================================================

BRIDGE_INTERFACE = "Realtek PCIe GbE Family Controller"

SIEM_IP   = "192.168.30.10"
DC_IP     = "192.168.10.20"
DOMAIN    = "empresa.local"
GATEWAY   = "192.168.10.1"

Vagrant.configure("2") do |config|

  # ===========================================================================
  # Deshabilitar carpeta sincronizada por defecto
  # ===========================================================================
  config.vm.synced_folder ".", "/vagrant", disabled: true


  # ===========================================================================
  # 1. SERVIDOR WEB - Ubuntu 22.04
  # ===========================================================================
  # NO SE MODIFICA LA CONFIGURACIÓN DEL WEB SERVER
  # ===========================================================================

  config.vm.define "web-server" do |web|

    web.vm.box      = "ubuntu/jammy64"
    web.vm.hostname = "web-server"

    web.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false

    web.vm.provider "virtualbox" do |vb|
      vb.name   = "SIEM-WebServer-VLAN10"
      vb.cpus   = 1
      vb.memory = 1024
      vb.customize ["modifyvm", :id, "--vram", "16"]
    end

    web.vm.provision "shell",
      path: "scripts/web-server.sh",
      env: {
        "VM_IP"      => "192.168.10.10",
        "VM_GATEWAY" => GATEWAY,
        "VM_DNS"     => DC_IP,
        "SIEM_IP"    => SIEM_IP,
        "DOMAIN"     => DOMAIN
      }
  end


  # ===========================================================================
  # 2. CONTROLADOR DE DOMINIO - Windows Server 2019
  # ===========================================================================

  config.vm.define "windows-dc" do |dc|

    dc.vm.box = "jborean93/WindowsServer2019"

    # IMPORTANTE:
    # No usamos dc.vm.hostname aquí para evitar el bug de Vagrant de "Waiting for reboot".
    # Lo solucionaremos con una Fase 0 manual.
    dc.vm.communicator = "winrm"

    dc.winrm.username = "vagrant"
    dc.winrm.password = "vagrant"

    dc.vm.boot_timeout = 1800

    dc.winrm.timeout = 1800
    dc.winrm.retry_limit = 100
    dc.winrm.max_wait_time = 1800


    # -------------------------------------------------------------------------
    # Red VLAN 10
    # -------------------------------------------------------------------------

    dc.vm.network "public_network",
      bridge: BRIDGE_INTERFACE.empty? ? nil : BRIDGE_INTERFACE,
      auto_config: false


    # -------------------------------------------------------------------------
    # VirtualBox
    # -------------------------------------------------------------------------

    dc.vm.provider "virtualbox" do |vb|

      vb.name   = "SIEM-WindowsDC-VLAN10"
      vb.cpus   = 2
      vb.memory = 2048
      vb.gui    = false

      vb.customize ["modifyvm", :id, "--vram", "32"]
      vb.customize ["modifyvm", :id, "--clipboard", "disabled"]
      vb.customize ["modifyvm", :id, "--draganddrop", "disabled"]

    end


    # -------------------------------------------------------------------------
    # Plugin para controlar el reinicio
    # -------------------------------------------------------------------------

    unless Vagrant.has_plugin?("vagrant-reload")
      raise "ERROR: Instala el plugin con: vagrant plugin install vagrant-reload"
    end


    # -------------------------------------------------------------------------
    # FASE 0: CAMBIO DE HOSTNAME MANUAL (Workaround para el bug de Vagrant)
    #
    # Cambiamos el nombre por código y hacemos un vagrant-reload seguro
    # antes de ejecutar la promoción a DC.
    # -------------------------------------------------------------------------
    dc.vm.provision "rename-hostname", type: "shell", powershell_elevated_interactive: false, inline: <<-SHELL
      $ExpectedName = "dc-empresa"
      if ($env:COMPUTERNAME -ne $ExpectedName) {
        Write-Host "Cambiando hostname a $ExpectedName..."
        Rename-Computer -NewName $ExpectedName -Force
      } else {
        Write-Host "El hostname ya es $ExpectedName. No requiere cambio."
      }
    SHELL

    dc.vm.provision :reload


    # -------------------------------------------------------------------------
    # FASE 1
    #
    # Configuración de red
    # Instalación AD DS
    # Instalación DNS
    # Promoción a controlador de dominio
    # Firewall
    # Auditoría
    #
    # El script NO reinicia Windows.
    # El reinicio lo hará vagrant-reload.
    # -------------------------------------------------------------------------

    dc.vm.provision "shell",
      path: "scripts/windows-dc.ps1",
      powershell_elevated_interactive: false,
      env: {
        "VM_IP"      => DC_IP,
        "VM_GATEWAY" => GATEWAY,
        "SIEM_IP"    => SIEM_IP,
        "DOMAIN"     => DOMAIN
      }


    # -------------------------------------------------------------------------
    # REINICIO CONTROLADO (Entre Fase 1 y Fase 2)
    # -------------------------------------------------------------------------

    dc.vm.provision :reload


    # -------------------------------------------------------------------------
    # FASE 2
    #
    # Usuarios
    # DNS
    # GPO
    # Wazuh Agent
    # RDP
    # -------------------------------------------------------------------------

    dc.vm.provision "shell",
      path: "scripts/windows-dc-second.ps1",
      powershell_elevated_interactive: false,
      env: {
        "SIEM_IP" => SIEM_IP,
        "DOMAIN"  => DOMAIN
      }

  end

end